# ==========================================
# ProjectPulse AI - .gitignore
# ==========================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
venv*/
.venv/
env/
ENV/
env.bak/
venv.bak/
venv_backend/

# --- Environment & Secret Variables ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Exception: allow template/example files
!.env.example
!.env.template
!backend/.env.example

# --- Databases & Local Storage ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump
*.sql

# --- Data & Ingestion Temporary Artifacts ---
**/data/raw/*
!**/data/raw/.gitkeep
**/data/staging/*
!**/data/staging/.gitkeep
**/data/processed/*
!**/data/processed/.gitkeep
**/data/uploads/*
!**/data/uploads/.gitkeep
**/data/exports/*
!**/data/exports/.gitkeep
*.pdf
*.xlsx
*.xls
*.csv
# Exceptions for test fixtures or sample data (if placed under tests/)
!**/tests/fixtures/*.csv
!**/tests/fixtures/*.xlsx
!**/tests/fixtures/*.pdf

# --- Logs & Runtime Files ---
*.log
logs/
*.pid
*.seed
*.pid.lock

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Editor & IDE Artifacts ---
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- ML Artifacts ---
backend/models/artifacts/*.joblib
backend/models/artifacts/*.pkl
backend/models/artifacts/latest.json
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/features/*
!backend/data/features/.gitkeep
*.parquet
